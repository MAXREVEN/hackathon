# Copy this file to ".env" (same folder) and edit. NEVER commit ".env".
LOST_ENV=development
# Long random string, e.g. run:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Optional: leave empty to use a local SQLite file (backend/lost.db)
DATABASE_URL=
# Optional, only for real AI summaries (needs audio capture, not built yet)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
